# Copy to .env and fill in the keys of the models you use; `ideataste` reads it from the current directory or any parent.
# Models are configured in src/ideataste/configs/models.yaml.

# deepseek-v4-flash (agent) and deepseek-v4-pro (schema extractor)
DEEPSEEK_API_KEY=
# gpt-5.6-luna (judge)
OPENAI_API_KEY=
# claude-haiku-4.5
ANTHROPIC_API_KEY=
# gemini-3.5-flash-lite
GOOGLE_API_KEY=
# k2-horizon
IFM_API_KEY=
# llama-4-scout (AWS Bedrock API key)
AWS_BEARER_TOKEN_BEDROCK=
# qwen3.8-27b served locally with vLLM (any value)
VLLM_API_KEY=

# Where the benchmark inputs are (default: ./data)
# IDEATASTE_DATA=/path/to/data
